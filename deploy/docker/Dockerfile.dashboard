# Dashboard image: Vite build served by nginx.
#
# The dashboard is static assets. API calls are same-origin and proxied to the
# control plane by the nginx config below, so no CORS configuration and no
# build-time API URL are needed.

FROM node:22-alpine AS builder

WORKDIR /build
COPY dashboard/package.json dashboard/package-lock.json* ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund

COPY dashboard/ ./
RUN npm run build

FROM nginx:1.27-alpine AS runtime

COPY --from=builder /build/dist /usr/share/nginx/html
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf

# nginx:alpine ships an unprivileged 'nginx' user; run as it and keep the
# writable paths it needs.
RUN touch /var/run/nginx.pid \
 && chown -R nginx:nginx /var/run/nginx.pid /var/cache/nginx /usr/share/nginx/html

USER nginx
EXPOSE 8081

HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1:8081/ >/dev/null || exit 1
