# Copy to .env and edit. Generate keys with:  openssl rand -hex 32

# --- required -----------------------------------------------------------
# Held by every SDK instance. May ship telemetry and read the published
# policy — nothing else.
KEEPER_CP_INGEST_API_KEYS=CHANGE_ME_ingest_key

# Held by people. Grants read access to the entire audit trail and the
# ability to publish policy. Keep these separate from ingest keys.
KEEPER_CP_ADMIN_API_KEYS=CHANGE_ME_admin_key

POSTGRES_PASSWORD=CHANGE_ME_postgres_password
KEEPER_CP_SESSION_SECRET=CHANGE_ME_session_secret

# --- environment --------------------------------------------------------
KEEPER_CP_ENVIRONMENT=development
KEEPER_CP_LOG_LEVEL=info
KEEPER_CP_PORT=8080
KEEPER_DASHBOARD_PORT=8081
KEEPER_CP_CORS_ORIGINS=http://localhost:8081,http://localhost:5173

# --- retention ----------------------------------------------------------
# 0 disables deletion entirely (required by some regimes; you then own the
# disk-space problem).
KEEPER_CP_RETENTION_DAYS=90

# --- alerting -----------------------------------------------------------
KEEPER_CP_ALERT_SLACK_WEBHOOK_URL=
KEEPER_CP_ALERT_WEBHOOK_URL=

# --- SIEM export --------------------------------------------------------
# webhook:https://...   syslog:host:514   syslog+tcp:host:601   otlp:https://...
KEEPER_CP_SIEM_ENABLED=false
KEEPER_CP_SIEM_TARGETS=
KEEPER_CP_SIEM_MIN_SEVERITY=low
